{
  "tools": [
    {
      "name": "web_search",
      "description": "按关键词在网上搜索，返回标题、网址和简介；可用 max_results 限制返回条数，最多 10 条。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query."
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5,
            "description": "Maximum number of results to return."
          }
        },
        "required": ["query"]
      },
      "tags": ["read"],
      "summary": {
        "zh": "按关键词在网上搜索，返回标题、网址和简介。",
        "en": "Search the web by keyword and return titles, URLs and snippets."
      }
    }
  ],
  "events": [
    {
      "type": "web-search.started",
      "description": {
        "zh": "世界已挂载。",
        "en": "The world was mounted."
      }
    }
  ]
}
