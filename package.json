{
  "name": "cortico-world-web-search-multi",
  "version": "0.5.0",
  "type": "module",
  "description": "Cortico World: 多 provider 聚合搜索（Anysearch / Tavily / Exa / Bocha / 阿里 IQS / 智谱 / Perplexity / Serper / Brave），跨源去重，暴露 web_search_multi 工具",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "web-search",
    "search",
    "meta-search"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "displayName": "聚合搜索",
    "locales": {
      "zh": { "displayName": "聚合搜索" },
      "en": { "displayName": "Aggregated Search" }
    },
    "kind": "world",
    "api": 6,
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "tags": [
      "internet",
      "requires-key"
    ]
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "build:webui": "tsc -p tsconfig.webui.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HorizonCloudy/cortico-world-web-search.git"
  },
  "homepage": "https://github.com/HorizonCloudy/cortico-world-web-search#readme",
  "bugs": {
    "url": "https://github.com/HorizonCloudy/cortico-world-web-search/issues"
  },
  "author": "HorizonCloudy"
}
